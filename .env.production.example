# ===== Production: cp .env.production.example .env rồi điền các giá trị <...> =====
APP_NAME="Quán Ăn Mini"
APP_ENV=production
# Tạo: docker compose -f compose.prod.yaml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Domain của website. Có SSL thì dùng https://
APP_URL=https://<domain>
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Nginx: domain để cấp SSL Let's Encrypt (make prod-ssl), cổng mở ra ngoài
SERVER_NAME=<domain>
LETSENCRYPT_EMAIL=<email nhận thông báo hết hạn SSL>
HTTP_PORT=80
HTTPS_PORT=443
# Đặt "*" nếu chạy sau Cloudflare / load balancer (SSL kết thúc ở proxy)
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=quan_an_mini
DB_USERNAME=quan_an_mini
DB_PASSWORD=<mật khẩu mạnh>
DB_ROOT_PASSWORD=<mật khẩu root mạnh>
MYSQL_BUFFER_POOL=256M

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true khi chạy HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@<domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Sao lưu: giờ chạy hằng ngày, số ngày giữ, thư mục trên máy chủ
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# Chạy migrate tự động khi container app khởi động (deploy.sh đã chạy migrate, nên để false)
AUTO_MIGRATE=false
PHP_FPM_MAX_CHILDREN=10
